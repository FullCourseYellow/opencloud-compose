# =============================================================================
# Full Course Yellow OpenCloud deployment
# =============================================================================
# Copy this file to the repository root as .env before deployment.

# Core deployment modules. Local PosixFS storage is used by default.
COMPOSE_FILE=docker-compose.yml:yjs/yjs.yml:weboffice/euro-office.yml:idm/external-idp.yml:fcy/compose.caddy.yaml
COMPOSE_PATH_SEPARATOR=:

# Do not skip TLS verification for public development domains.
INSECURE=false
LOG_DRIVER=local
LOG_LEVEL=info
LOG_PRETTY=false

# OpenCloud rolling is pinned because the current Yjs integration targets 8.x.
OC_DOCKER_IMAGE=opencloudeu/opencloud-rolling
OC_DOCKER_TAG=8.0.1
OC_DOMAIN=dev-cloud.fullcourseyellow.com
OC_CONTAINER_UID_GID=1000:1000
DEFAULT_LANGUAGE=en
DEMO_USERS=false
CHECK_FOR_UPDATES=true
PROXY_ENABLE_BASIC_AUTH=false
START_ADDITIONAL_SERVICES=
# Not used by the external-IDP deployment, but defined to keep base Compose
# interpolation explicit.
INITIAL_ADMIN_PASSWORD=

# Notifications are disabled unless added to START_ADDITIONAL_SERVICES.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=

# Leave empty to use Docker named volumes. Bind-mounted paths must be writable
# by the UID/GID configured in OC_CONTAINER_UID_GID.
OC_CONFIG_DIR=
OC_DATA_DIR=
LDAP_CERTS_DIR=
LDAP_DATA_DIR=

# Euro Office is community-supported and currently publishes a moving latest
# image. Pin EURO_OFFICE_DOCKER_TAG when a tested versioned image is available.
EURO_OFFICE_DOMAIN=dev-office.fullcourseyellow.com
EURO_OFFICE_DOCKER_IMAGE=ghcr.io/euro-office/documentserver
EURO_OFFICE_DOCKER_TAG=latest
EURO_OFFICE_JWT_SECRET=replace-with-at-least-32-random-characters

# Yjs collaborative editing service.
YJS_DOCKER_IMAGE=opencloudeu/yjs
YJS_DOCKER_TAG=1.0.0

# Existing FCY Keycloak realm. OpenCloud stores provisioned directory records
# in its own private LDAP service; Keycloak remains the authentication source.
IDP_DOMAIN=dev-id.fullcourseyellow.com
IDP_ISSUER_URL=https://dev-id.fullcourseyellow.com/realms/fullcourseyellow
IDP_ACCOUNT_URL=https://dev-id.fullcourseyellow.com/realms/fullcourseyellow/account
LDAP_BIND_PASSWORD=replace-with-a-strong-random-password

# Keycloak emits the assigned OpenCloud realm role as a top-level roles claim.
PROXY_ROLE_ASSIGNMENT_DRIVER=oidc
PROXY_ROLE_ASSIGNMENT_OIDC_CLAIM=roles
GRAPH_ASSIGN_DEFAULT_USER_ROLE=false
OC_OIDC_CLIENT_ID=web
OC_OIDC_CLIENT_SCOPES=openid profile email

# OIDC clients advertised through OpenCloud WebFinger discovery.
WEBFINGER_WEB_OIDC_CLIENT_ID=web
WEBFINGER_WEB_OIDC_CLIENT_SCOPES=openid profile email
WEBFINGER_DESKTOP_OIDC_CLIENT_ID=OpenCloudDesktop
WEBFINGER_DESKTOP_OIDC_CLIENT_SCOPES=openid profile email offline_access
WEBFINGER_ANDROID_OIDC_CLIENT_ID=OpenCloudAndroid
WEBFINGER_ANDROID_OIDC_CLIENT_SCOPES=openid profile email offline_access
WEBFINGER_IOS_OIDC_CLIENT_ID=OpenCloudIOS
WEBFINGER_IOS_OIDC_CLIENT_SCOPES=openid profile email offline_access

# Caddy and HarborDNS integration.
CADDY_ACME_SNIPPET=dns-acme-fcy
HARBORDNS_AUTO_REMOVE=true

# Optional S3 primary storage. Add storage/decomposeds3.yml to COMPOSE_FILE
# before the first deployment, then configure every value below.
# DECOMPOSEDS3_ENDPOINT=https://s3.example.com
# DECOMPOSEDS3_REGION=eu-central-1
# DECOMPOSEDS3_ACCESS_KEY=replace-with-s3-access-key
# DECOMPOSEDS3_SECRET_KEY=replace-with-s3-secret-key
# DECOMPOSEDS3_BUCKET=opencloud
